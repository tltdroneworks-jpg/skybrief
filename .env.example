# Optional. Live NOTAM text stays empty until one of these providers is configured.
# Official RSA NOTAMs remain ATNS File2Fly regardless.

# Recommended for South Africa (Eurocontrol EAD).
# 1. Free account: https://www.autorouter.aero/
# 2. Open a support ticket and ask them to enable API access.
# 3. Put your account email and password here, then restart the server.
AUTOROUTER_USER=
AUTOROUTER_PASSWORD=

# Alternative: FAA NOTAM API. International (FA**) coverage is not guaranteed.
# 1. Register at https://api.faa.gov
# 2. Request Production access to the NOTAM API.
# 3. Copy client_id and client_secret from My Applications.
FAA_CLIENT_ID=
FAA_CLIENT_SECRET=

# Alternative: ICAO API Data Service (100 free calls, then paid).
# Register at https://www.icao.int/api-data-service-2
ICAO_API_KEY=
